# =============================================================================
# Aguiar ERP — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# NUNCA versione valores reais. NUNCA use a chave secret/service_role aqui.
# =============================================================================

# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) — ou a antiga "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do sistema (usada nos links de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente para os testes de banco (PostgreSQL local, nunca o de produção)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aguiar_test
